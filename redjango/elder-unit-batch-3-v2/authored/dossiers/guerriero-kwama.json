    "lore": [
      {
        "id": 65,
        "unitId": 981,
        "name": "Guerriero Kwama",
        "description": "I Guerrieri Kwama vivono nelle colonie sotterranee di Morrowind, soprattutto nelle miniere di uova che sostengono una parte importante dell'economia dunmer. Difendono tunnel, regina, operai e nidi dagli intrusi, dai predatori e da chiunque porti odori estranei alla colonia. Per i minatori esperti sono una presenza da rispettare, non solo un pericolo da evitare. Non hanno una personalità individuale comprensibile, ma agiscono con disciplina istintiva. Reagiscono alla minaccia in modo rapido e coordinato, come se l'intera colonia pensasse attraverso di loro. Non sono crudeli, ma sono completamente indifferenti alle ragioni di chi entra nel loro territorio. Hanno corpo insettoide, corazza resistente e attacchi potenti, spesso accompagnati da sostanze irritanti o velenose. Sono più grandi e aggressivi degli operai, e il loro ruolo è chiaramente quello di soldati della colonia. In uno spazio stretto, con altri Kwama intorno, possono bloccare l'avanzata di un gruppo intero.",
        "image": "UnitLorePics/Guerriero_Kwama.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      }
    ]
  },
