    "lore": [
      {
        "id": 28,
        "unitId": 989,
        "name": "Capra dei Ghiacciai",
        "description": "Le Capre dei Ghiacciai vivono sulle vette innevate di Skyrim, tra dirupi, passi montani e pendii dove pochi animali riescono a trovare nutrimento. Sono comuni nelle zone fredde e impervie, spesso viste da cacciatori, pellegrini e viandanti che attraversano le montagne. Per molti villaggi isolati rappresentano una fonte preziosa di carne, latte, pelle e corna. Sono creature diffidenti, testarde e sorprendentemente coraggiose quando messe alle strette. Non cercano lo scontro, ma non sono nemmeno indifese: una capra adulta sa usare il terreno meglio di molti predatori. Il loro istinto principale è la sopravvivenza, e questo le rende difficili da catturare vive. Hanno zoccoli adatti alla roccia, mantello folto e un equilibrio quasi innaturale sui pendii ghiacciati. Le corna possono ferire seriamente un aggressore, soprattutto se l'animale carica dall'alto. Non sono mostri, ma nelle montagne di Skyrim anche una semplice capra può ricordare agli avventurieri che il terreno è parte del pericolo.",
        "image": "UnitLorePics/Capra_dei_Ghiacciai.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      },
      {
        "sourceId": 67,
        "name": "Scatto Rapido",
        "description": "La creatura scatta a velocità incredibile, colmando distanze o sfuggendo rapidamente.",
        "effect": "Si muove per almeno 3 esagoni fino a un massimo di 6 esagoni in linea retta evitando tutti gli attacchi di opportunità.",
        "cost": "6 PA, 2 EN.",
        "boost": "Per 3 POW, aumenta il movimento a 8 esagoni. Per 8 POW, può attraversare gli NPC e infliggere danni a tutti gli NPC entro 1 esagono dalla linea di movimento pari a (livello/2)d10 danni da taglio."
      }
    ]
  },
