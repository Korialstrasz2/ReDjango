    "lore": [
      {
        "id": 56,
        "unitId": 1016,
        "name": "Fantasma",
        "description": "I Fantasmi si trovano in rovine, castelli abbandonati, tombe, campi di battaglia e case dove qualcosa è rimasto irrisolto. Non tutti sono malvagi: alcuni proteggono un luogo, altri ripetono un dolore, altri ancora non capiscono nemmeno di essere morti. In Tamriel, la morte non sempre chiude una storia. Sono malinconici, vendicativi o confusi, a seconda del legame che li trattiene. Molti reagiscono agli intrusi come minacce, specialmente se il luogo della loro morte viene profanato. Altri cercano aiuto, ma lo fanno con segni, apparizioni e frammenti di memoria più che con parole chiare. Il loro corpo è incorporeo, difficile da ferire con armi comuni e spesso legato a un oggetto, una colpa o una promessa. Possono prosciugare energia, spaventare i viventi o manifestarsi in forme instabili. Per liberarli davvero, a volte non basta combattere: bisogna capire cosa li tiene ancora qui.",
        "image": "UnitLorePics/Fantasma.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 33,
        "name": "Forma Eterea",
        "description": "La creatura può entrare in uno stato etereo.",
        "effect": "Ottiene resistenza al danno fisico del 50%, ma subisce il 25% di danno magico in più.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, annulla la penalità al danno magico per un turno."
      },
      {
        "sourceId": 36,
        "name": "Sottrazione Spirituale",
        "description": "Assorbe energia spirituale dai nemici.",
        "effect": "Infligge (2d6 + livello) danni e riduce la saggezza del bersaglio di 2 per 2 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 4 POW, colpisce fino a 2 bersagli entro la portata."
      },
      {
        "sourceId": 40,
        "name": "Spostamento Fase",
        "description": "La creatura può sfuggire alla realtà.",
        "effect": "Ogni volta che la creatura viene attaccata, c'è il 25% di possibilità che l'attacco manchi completamente.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, la probabilità aumenta al 50% per un turno."
      }
    ]
  },
