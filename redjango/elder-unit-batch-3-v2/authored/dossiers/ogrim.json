    "lore": [
      {
        "id": 88,
        "unitId": 1004,
        "name": "Ogrim",
        "description": "Gli Ogrim sono Daedra massicci e grotteschi, incontrati nei piani di Oblivion e talvolta evocati a Nirn da cultisti o stregoni poco prudenti. Vengono associati a diversi Principi, ma compaiono spesso dove la brutalità, l'eccesso o la degradazione fisica hanno valore simbolico. La loro presenza rende qualunque spazio più stretto e più sgradevole. Sono ottusi, violenti e difficili da intimidire. Non hanno l'eleganza crudele dei Dremora né l'astuzia dei Daedra più sottili, ma possiedono una fiducia enorme nella propria massa. Sembrano capire poche cose, e una di queste è che quasi tutto può essere schiacciato. Hanno corpo enorme, pelle spessa e una forza capace di travolgere porte, scudi e uomini. Possono rigenerarsi o resistere a ferite che fermerebbero creature più piccole. Non sono raffinati, ma quando un Ogrim entra in combattimento spesso la tattica migliore diventa semplicemente non stare davanti a lui.",
        "image": "UnitLorePics/Ogrim.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 20,
        "name": "Pestone Tonante",
        "description": "Colpisce il suolo causando un piccolo terremoto.",
        "effect": "I nemici entro 2 esagoni subiscono (3d6 + livello) danni contundenti e possono essere storditi per 1 turno.",
        "cost": "7 PA, 6 EN.",
        "boost": "Per 5 POW, aumenta la durata dello stordimento a 2 turni."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
  },
