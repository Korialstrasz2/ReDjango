    "lore": [
      {
        "id": 98,
        "unitId": 993,
        "name": "Ragno Frostbite",
        "description": "I Ragni Frostbite abitano caverne, foreste fredde, miniere e rovine di Skyrim. Sono tra i predatori più comuni e odiati dai viaggiatori del nord, perché annidano in luoghi che sembrano ripari sicuri. Molti avventurieri imparano a temere le ragnatele prima ancora di vedere la creatura. Sono aggressivi, pazienti e guidati da un istinto predatorio molto efficace. Restano nascosti finché la preda non si avvicina abbastanza, poi attaccano con rapidità disgustosa. Non sono intelligenti come un nemico umano, ma il loro modo di cacciare è perfettamente adatto all'ambiente. Hanno veleno debilitante, zampe rapide e una capacità notevole di muoversi su pareti e soffitti. Gli esemplari più grandi possono bloccare passaggi interi con ragnatele e corpi delle vittime. In gruppo o in spazi chiusi diventano una minaccia molto più seria di quanto suggerisca la loro diffusione.",
        "image": "UnitLorePics/Ragno_Frostbite.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 5,
        "name": "Trappola di Ragnatela",
        "description": "La creatura lancia una ragnatela appiccicosa per immobilizzare i nemici.",
        "effect": "Il bersaglio entro 5 esagoni deve effettuare un controllo di agilità pari a 5+lv/2 o avere metà PA per un turno. Può anche metterla a terra, e colpisce chi ci cammina su.",
        "cost": "2 PA, 4 EN.",
        "boost": "Per 3 POW, colpisce fino a 2 bersagli entro la portata."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      }
    ]
  },
