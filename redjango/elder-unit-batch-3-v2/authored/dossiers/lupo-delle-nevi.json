    "lore": [
      {
        "id": 73,
        "unitId": 985,
        "name": "Lupo delle Nevi",
        "description": "I Lupi delle Nevi abitano le regioni fredde di Skyrim, Solstheim e delle montagne settentrionali, dove il mantello chiaro li confonde con ghiaccio e tormenta. Sono più robusti e aggressivi dei lupi comuni, adattati a un ambiente in cui ogni pasto va conquistato. Le carovane che attraversano passi innevati li temono con ragione. Sono diffidenti, affamati e molto legati al branco. Non sprecano energie in inseguimenti inutili, ma quando scelgono una preda lo fanno con ostinazione feroce. I Nord li rispettano come creature dure, nate dallo stesso gelo che mette alla prova gli uomini. Hanno pelliccia folta, muscoli resistenti e grande capacità di muoversi su neve e roccia. Attaccano in gruppo, cercando di isolare i bersagli più deboli o rallentati. Un Lupo delle Nevi non è solo un lupo più grande: è un predatore costruito per un mondo che perdona poco.",
        "image": "UnitLorePics/Lupo_delle_Nevi.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 62,
        "name": "Balzo Predatorio",
        "description": "La creatura si lancia sulla preda con precisione letale.",
        "effect": "Salta fino a 3 esagoni su una casella adiacente al bersaglio ed esegue un attacco con +3 all'Attacco e 1 reroll per l'attacco.",
        "cost": "7 PA, 2 EN.",
        "boost": "Per 5 POW, ottieni 2 reroll, e il raggio può essere di 3 o 4 esagoni."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 68,
        "name": "Rigenerazione",
        "description": "La creatura guarisce naturalmente le ferite col tempo, migliorando la sua longevità in combattimento.",
        "effect": "Recupera 1d6 Punti Ferita all'inizio di ogni turno per livello dell'NPC.",
        "cost": "N/A (Passiva).",
        "boost": "Per 3 POW, aumenta la guarigione a 3d6."
      }
    ]
  },
