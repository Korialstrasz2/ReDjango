    "lore": [
      {
        "id": 60,
        "unitId": 972,
        "name": "Guar",
        "description": "I Guar sono tra gli animali più tipici di Morrowind, allevati dai Dunmer come bestie da soma, cavalcature e fonte di carne e pelle. Li si trova nelle fattorie, nelle carovane, nei villaggi ashlander e lungo le piste polverose che attraversano Vvardenfell e la terraferma. In una regione ostile come Morrowind, un Guar affidabile vale più di molti cavalli. Sono docili, resistenti e più intelligenti di quanto il loro aspetto lasci immaginare. Tendono ad affezionarsi a chi li nutre e li guida con pazienza, ma possono diventare testardi se trattati male. Gli Ashlander e molti contadini dunmer li considerano quasi compagni di lavoro, non semplici animali. Hanno corpo robusto, passo stabile e una buona resistenza a caldo, polvere e terreni difficili. Non sono predatori, ma un Guar spaventato o addestrato alla guerra può travolgere un uomo con il peso del corpo. La loro utilità quotidiana li rende una delle creature più importanti della vita comune di Morrowind.",
        "image": "UnitLorePics/Guar.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 16,
        "name": "Colpo di Coda",
        "description": "Scuote la coda in un ampio arco per colpire più nemici.",
        "effect": "Attacca con danni contundenti a tutti i PG adiacenti in un arco di ampiezza a scelta; possibilità di sbilanciare abbasstando di 2 i PA.",
        "cost": "6 PA, 4 EN.",
        "boost": "Per 4 POW, +4 atk, +30% danno"
      },
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      }
    ]
