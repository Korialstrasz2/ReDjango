    "lore": [
      {
        "id": 50,
        "unitId": 1015,
        "name": "Draugr Signore della Morte",
        "description": "I Draugr Signori della Morte riposano nelle camere più profonde dei tumuli nordici, spesso vicino ai sepolcri dei Sacerdoti Drago o ai tesori più protetti. Non sono guardiani comuni, ma campioni dell'antico Culto del Drago, preservati con rituali più forti e crudeli. Quando uno di loro si risveglia, l'intero tumulo sembra farlo con lui. Sono intelligenti abbastanza da usare tattica, pazienza e terrore. Conservano un frammento della propria autorità, e gli altri Draugr spesso sembrano muoversi intorno a loro come soldati intorno a un comandante. La loro presenza comunica una certezza semplice: per loro, la guerra non è mai finita. Sono più forti, più resistenti e meglio armati dei Draugr comuni. Molti sanno usare la Thu'um in forma limitata, disarmando, respingendo o gelando gli avversari con un comando antico. Affrontarli richiede preparazione, perché non sono solo non morti: sono veterani di un'era in cui i draghi governavano davvero.",
        "image": "UnitLorePics/Draugr_Signore_della_Morte.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      },
      {
        "sourceId": 49,
        "name": "Aura della Paura",
        "description": "La presenza incute timore nei nemici vicini.",
        "effect": "I nemici entro 2 esagoni hanno il loro attacco e difesa ridotti di 2.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può sopprimere l'effetto per 2 turni per causare un effetto di paura."
      },
      {
        "sourceId": 42,
        "name": "Rianima Morti",
        "description": "Risveglia un nemico caduto per combattere come alleato.",
        "effect": "Rianima un nemico sconfitto di livello fino a quello della creatura -2.",
        "cost": "7 PA, 7 EN.",
        "boost": "Per 5 POW, l'alleato rianimato guadagna +2 forza e resistenza."
      }
    ]
  },
