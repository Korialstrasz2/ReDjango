    "lore": [
      {
        "id": 68,
        "unitId": 974,
        "name": "Kagouti",
        "description": "I Kagouti vivono nelle terre aride e nelle distese selvagge di Morrowind, dove ceneri, pietra e scarsa vegetazione favoriscono predatori robusti e aggressivi. Sono particolarmente temuti da viaggiatori, pastori di guar e tribù ashlander che devono attraversare territori aperti. La loro presenza è spesso annunciata troppo tardi, quando la carica è già partita. Sono territoriali, irritabili e molto più audaci di molte altre bestie. Non sempre attaccano per fame: a volte basta invadere il loro spazio o sembrare una minaccia. Gli Ashlander li rispettano come creature dure della terra dura, ma questo rispetto non impedisce di cacciarli quando serve. Hanno corpo possente, zampe forti e una testa adatta a caricare e mordere con violenza. La loro pelle è resistente, le zanne sono apprezzate come trofei e parti del corpo possono avere usi alchemici o artigianali. In campo aperto sono pericolosi perché possono chiudere rapidamente la distanza e travolgere un avversario impreparato.",
        "image": "UnitLorePics/Kagouti.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 25,
        "name": "Morso Infettivo",
        "description": "Morsi che trasportano una malattia virulenta.",
        "effect": "Gli attacchi in mischia hanno il 25% di possibilità di infettare il bersaglio con una malattia che riduce la resistenza di 2 per 3 turni.",
        "cost": "N/A (Passiva).",
        "boost": "N/A (Passiva)."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
