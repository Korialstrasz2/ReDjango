    "lore": [
      {
        "id": 76,
        "unitId": 1011,
        "name": "Mago Scheletro",
        "description": "I Maghi Scheletro si trovano in tombe, rovine e sale rituali dove la magia ha preservato non solo le ossa, ma anche un frammento della conoscenza arcana del defunto. Possono essere antichi stregoni risvegliati, servi di Lich o resti evocati da necromanti che preferiscono soldati capaci di lanciare incantesimi. Sono meno comuni degli scheletri armati, ma molto più insidiosi. Non hanno una personalità viva, eppure in loro resta qualcosa di inquietante: il gesto appreso, la postura del sapiente, l'abitudine a comandare energie che non dovrebbero più rispondere. Sembrano ricordare la magia meglio della propria identità. Questo li rende meno vuoti e più disturbanti dei non morti ordinari. Usano incantesimi offensivi, protezioni, maledizioni e talvolta evocazioni minori. Il loro corpo è fragile, ma la distanza e la magia compensano la mancanza di carne. Se protetti da altri non morti, possono trasformare una cripta apparentemente semplice in una trappola mortale.",
        "image": "UnitLorePics/Mago_Scheletro.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 9,
        "name": "Palla di Fuoco",
        "description": "Conjura una palla di fuoco da lanciare ai nemici.",
        "effect": "Infligge (3d6 + livello) danni da fuoco a un bersaglio entro 6 esagoni; danni ad area di (livello)d4 agli esagoni adiacenti.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d8 e il raggio dell'area a 2 esagoni."
      },
      {
        "sourceId": 24,
        "name": "Sottrazione di Energia",
        "description": "Sottrae energia dal bersaglio per ripristinare la propria.",
        "effect": "Riduce l'EN del bersaglio di 5 e ripristina la stessa quantità alla creatura.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, drena anche 5 POW dal bersaglio."
      },
      {
        "sourceId": 40,
        "name": "Spostamento Fase",
        "description": "La creatura può sfuggire alla realtà.",
        "effect": "Ogni volta che la creatura viene attaccata, c'è il 25% di possibilità che l'attacco manchi completamente.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, la probabilità aumenta al 50% per un turno."
      }
    ]
