    "lore": [
      {
        "id": 67,
        "unitId": 998,
        "name": "Hunger",
        "description": "Gli Hunger sono Daedra famelici associati soprattutto a Boethiah e ad alcuni reami inquieti dell'Oblivion, anche se possono apparire a Nirn tramite evocazioni o varchi instabili. Le storie dunmer li descrivono come creature da incubo, emerse da luoghi dove fame, predazione e disprezzo per la debolezza diventano forma vivente. Non sono comuni, e chi li evoca spesso sopravvaluta la propria capacità di controllarli. Sono crudeli, voraci e dotati di un'intelligenza bestiale ma non stupida. Osservano la preda con un desiderio che sembra fisico e spirituale insieme, come se volessero consumare non solo carne ma forza, coraggio e volontà. La loro presenza mette a disagio perché comunica fame pura, senza bisogno di parole. Hanno arti lunghi, artigli, lingua prensile e capacità innaturali legate al drenaggio della forza vitale. Sono rapidi, sgradevoli da affrontare da vicino e spesso dotati di poteri debilitanti. Un Hunger non cerca uno scontro onorevole: cerca il momento in cui la vittima è più vulnerabile.",
        "image": "UnitLorePics/Hunger.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 18,
        "name": "Sottrai Vita",
        "description": "Draga l'energia vitale dal bersaglio.",
        "effect": "Riduce il bersaglio di (2d6 + livello) Punti Ferita e cura la creatura dello stesso ammontare.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d8."
      },
      {
        "sourceId": 36,
        "name": "Sottrazione Spirituale",
        "description": "Assorbe energia spirituale dai nemici.",
        "effect": "Infligge (2d6 + livello) danni e riduce la saggezza del bersaglio di 2 per 2 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 4 POW, colpisce fino a 2 bersagli entro la portata."
      },
      {
        "sourceId": 25,
        "name": "Morso Infettivo",
        "description": "Morsi che trasportano una malattia virulenta.",
        "effect": "Gli attacchi in mischia hanno il 25% di possibilità di infettare il bersaglio con una malattia che riduce la resistenza di 2 per 3 turni.",
        "cost": "N/A (Passiva).",
        "boost": "N/A (Passiva)."
      }
    ]
