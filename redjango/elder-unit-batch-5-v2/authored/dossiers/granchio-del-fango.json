    "lore": [
      {
        "id": 59,
        "unitId": 976,
        "name": "Granchio del Fango",
        "description": "I Granchi del Fango vivono lungo coste, paludi, rive di fiumi e zone umide di tutta Tamriel. Sono così comuni che molti viaggiatori li considerano poco più di un fastidio, ma chi vive vicino all'acqua sa che possono diventare aggressivi se disturbati. In alcune regioni sono anche una fonte semplice di cibo. Sono creature semplici, guardinghe e legate al proprio piccolo territorio. Passano molto tempo sepolti nel fango o nascosti tra rocce e detriti, emergendo quando percepiscono cibo o minaccia. Non hanno malizia, ma possiedono l'ostinazione tipica degli animali che non capiscono quando sarebbe meglio fuggire. Hanno carapace duro, chele robuste e una sorprendente capacità di mimetizzarsi negli ambienti fangosi. Da soli sono raramente letali per un avventuriero esperto, ma possono ferire, intralciare o sorprendere chi li sottovaluta. Gli esemplari più grandi, invece, meritano decisamente più rispetto.",
        "image": "UnitLorePics/Granchio_del_Fango.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      },
      {
        "sourceId": 27,
        "name": "Sangue Tossico",
        "description": "Il sangue della creatura è corrosivo per gli attaccanti.",
        "effect": "Gli attaccanti in mischia subiscono danni da veleno pari a (livello)d4 quando infliggono danno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 3 POW, il danno da veleno aumenta a d6 per un turno."
      }
    ]
  },
