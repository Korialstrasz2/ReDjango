    "lore": [
      {
        "id": 84,
        "unitId": 990,
        "name": "Netch (Betty)",
        "description": "Le Betty Netch fluttuano nelle terre di Morrowind, soprattutto nelle zone costiere e nelle regioni aperte dove il cielo sembra più grande della terra. Sono creature familiari ai Dunmer, spesso viste come parte naturale del paesaggio insieme ai guar, alle torri di fungo e alle distese di cenere. Per molti viaggiatori stranieri, incontrarne una è uno dei primi veri segni di essere arrivati a Morrowind. Sono pacifiche, lente e quasi solenni nei movimenti. Non cercano lo scontro e raramente reagiscono se non minacciate o disturbate. La loro calma ha qualcosa di ipnotico, come se vivessero seguendo correnti invisibili che i mortali non percepiscono. Hanno corpo galleggiante, tentacoli e una pelle preziosa usata tradizionalmente dai Dunmer. Le femmine sono generalmente più tranquille dei Bull Netch e vengono cacciate o allevate per materiali utili. Non sono predatori, ma la loro stazza impone comunque rispetto.",
        "image": "UnitLorePics/Netch_Betty.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      }
    ]
  },
