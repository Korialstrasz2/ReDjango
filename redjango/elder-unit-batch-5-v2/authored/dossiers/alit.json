    "lore": [
      {
        "id": 4,
        "unitId": 973,
        "name": "Alit",
        "description": "Gli Alit si trovano nelle distese di cenere, nelle paludi e nelle terre selvagge di Morrowind, dove il terreno duro e la vita ostile favoriscono creature rapide e aggressive. Li si incontra spesso nelle zone meno civilizzate, lontano dalle mura delle città. Lì, tra rocce e polvere, si muovono come predatori nati per il paesaggio. Sono istintivi, territoriali e aggressivi. Un Alit non cerca la lotta, ma non la evita neppure: reagisce a ogni intrusione con la violenza di una bestia che difende il proprio spazio. In branco diventano ancora più pericolosi, perché si coordinano quanto basta per travolgere una preda. Hanno artigli, denti robusti e un corpo agile che li rende difficili da colpire. Sono creature adattate alla caccia e alla sopravvivenza, non alla pietà. Chi li sottovaluta di solito impara troppo tardi quanto velocemente possano chiudere la distanza.",
        "image": "UnitLorePics/Alit.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      }
    ]
  },
