    "lore": [
      {
        "id": 31,
        "unitId": 994,
        "name": "Chaurus",
        "description": "I Chaurus abitano le caverne profonde di Skyrim e le zone sotterranee occupate dai Falmer. Si trovano in nidi umidi, tunnel bui e colonie dove la chitina, le uova e il veleno fanno parte dell'ecosistema locale. Per chi scende troppo in profondità, il loro rumore raschiante è spesso il primo segnale che la fuga potrebbe essere difficile. Sono animali aggressivi, territoriali e poco inclini a distinguere tra preda e intruso. I Falmer riescono a sfruttarli e allevarli, ma questo non li rende domestici nel senso comune. Sono creature guidate da fame, difesa del nido e istinto collettivo. Hanno mandibole potenti, corazza chitinosa e un veleno capace di debilitare rapidamente un avversario. La loro struttura li rende resistenti e sgradevoli da affrontare in spazi stretti. Anche un singolo Chaurus può essere pericoloso, ma in un nido intero la minaccia diventa soffocante.",
        "image": "UnitLorePics/Chaurus.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 5,
        "name": "Trappola di Ragnatela",
        "description": "La creatura lancia una ragnatela appiccicosa per immobilizzare i nemici.",
        "effect": "Il bersaglio entro 5 esagoni deve effettuare un controllo di agilità pari a 5+lv/2 o avere metà PA per un turno. Può anche metterla a terra, e colpisce chi ci cammina su.",
        "cost": "2 PA, 4 EN.",
        "boost": "Per 3 POW, colpisce fino a 2 bersagli entro la portata."
      }
    ]
  },
