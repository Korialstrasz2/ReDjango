    "lore": [
      {
        "id": 94,
        "unitId": 977,
        "name": "Pesce Carnefice",
        "description": "I Pesci Carnefice vivono nei fiumi, nelle paludi e nelle acque costiere di molte province, soprattutto dove la visibilità è scarsa e le rive offrono nascondigli. Sono temuti da pescatori, contrabbandieri e viaggiatori costretti ad attraversare corsi d'acqua infestati. La superficie calma spesso nasconde il loro vero vantaggio. Sono predatori semplici, aggressivi e territoriali. Non possiedono astuzia raffinata, ma reagiscono rapidamente a sangue, movimento e vibrazioni nell'acqua. Una volta iniziato l'attacco, è difficile convincerli a desistere. Hanno denti affilati, mascelle potenti e una rapidità che in acqua li rende molto più pericolosi di quanto sarebbero sulla terra. Possono attaccare in gruppo e mutilare una vittima prima che riesca a raggiungere la riva. Contro di loro, l'errore più comune è pensare che un fiume basso sia un fiume sicuro.",
        "image": "UnitLorePics/Pesce_Carnefice.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 25,
        "name": "Morso Infettivo",
        "description": "Morsi che trasportano una malattia virulenta.",
        "effect": "Gli attacchi in mischia hanno il 25% di possibilità di infettare il bersaglio con una malattia che riduce la resistenza di 2 per 3 turni.",
        "cost": "N/A (Passiva).",
        "boost": "N/A (Passiva)."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 50,
        "name": "Divorare",
        "description": "Consuma un nemico sconfitto per recuperare forze.",
        "effect": "Può bersagliare solo un nemico caduto; recupera (livello nemico*2) Punti Ferita e guadagna +2 forza per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, recupera anche LV/2 EN e LV/2 POW."
      }
    ]
  },
