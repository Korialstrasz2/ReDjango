    "lore": [
      {
        "id": 106,
        "unitId": 979,
        "name": "Scrib",
        "description": "Gli Scrib vivono nelle colonie Kwama di Morrowind, soprattutto nelle miniere di uova e nei tunnel dove la vita sotterranea segue ritmi propri. Sono piccoli, molli e molto comuni, spesso visti dai minatori come una presenza quasi domestica. Per molti Dunmer rappresentano tanto una risorsa alimentare quanto un segno familiare della vita quotidiana. Sono docili, lenti e poco inclini ad attaccare se non minacciati. Non hanno grande intelligenza individuale, ma sembrano perfettamente inseriti nell'ordine della colonia. La loro esistenza è semplice: nutrirsi, crescere, evitare predatori e contribuire al ciclo dei Kwama. Non sono forti, ma possono difendersi con un morso paralizzante sorprendentemente efficace. La loro carne e la gelatina ricavata dal corpo vengono usate nella cucina e nell'alchimia dunmer. Chi ride troppo di uno Scrib di solito non ha mai provato a essere morso da uno mentre scivola nel fango di una miniera.",
        "image": "UnitLorePics/Scrib.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 19,
        "name": "Nuvola di Spore",
        "description": "Rilascia una nuvola di spore tossiche.",
        "effect": "Tutti i nemici entro 2 esagoni devono effettuare un controllo di resistenza o essere avvelenati e accecati per 2 turni.",
        "cost": "6 PA, 6 EN.",
        "boost": "Per 5 POW, aumenta la portata a 3 esagoni."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 26,
        "name": "Stridio Sonico",
        "description": "Emette uno stridio acuto che disorienta i nemici.",
        "effect": "I nemici entro 4 esagoni devono effettuare un controllo di concentrazione o essere storditi per 1 turno.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, riduce l'attacco dei nemici colpiti di 2 per 2 turni."
      }
    ]
  },
