    "lore": [
      {
        "id": 126,
        "unitId": 987,
        "name": "Tigre denti a Sciabola",
        "description": "Le Tigri denti a Sciabola vivono nelle tundre, nelle foreste fredde e nelle montagne di Skyrim e delle regioni settentrionali. Sono predatori antichi, più grandi e pericolosi dei comuni felini, spesso incontrati da cacciatori che cercano trofei e da viaggiatori che speravano soltanto di attraversare un passo innevato. Il loro territorio è silenzioso finché non è troppo tardi. Sono solitarie, pazienti e fiere nel modo in cui solo un grande predatore può esserlo. Non sprecano energie in attacchi inutili, ma quando scelgono una preda lo fanno con precisione brutale. I Nord le rispettano perché rappresentano una forma pura di forza selvaggia, senza malizia e senza esitazione. Hanno muscoli potenti, artigli, riflessi rapidi e lunghi canini capaci di infliggere ferite devastanti. Attaccano con balzi improvvisi e cercano il collo o i punti vitali della preda. La loro pelle e i loro denti sono trofei preziosi, ma ottenerli significa convincere una delle bestie più letali del nord a morire prima di te.",
        "image": "UnitLorePics/Tigre_denti_a_Sciabola_e8taXJO.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 62,
        "name": "Balzo Predatorio",
        "description": "La creatura si lancia sulla preda con precisione letale.",
        "effect": "Salta fino a 3 esagoni su una casella adiacente al bersaglio ed esegue un attacco con +3 all'Attacco e 1 reroll per l'attacco.",
        "cost": "7 PA, 2 EN.",
        "boost": "Per 5 POW, ottieni 2 reroll, e il raggio può essere di 3 o 4 esagoni."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      }
    ]
  },
