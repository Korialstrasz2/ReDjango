    "lore": [
      {
        "id": 99,
        "unitId": 992,
        "name": "Ragno Gigante",
        "description": "I Ragni Giganti vivono in foreste profonde, caverne, rovine e luoghi dove il tempo ha permesso alle loro tane di espandersi indisturbate. Non sono semplici ragni ingranditi, ma predatori dominanti capaci di trasformare un'intera area in territorio di caccia. Le loro ragnatele sono spesso il primo avvertimento, se non è già troppo tardi. Sono pazienti, territoriali e spaventosamente metodici. Non inseguono sempre la preda in campo aperto: preferiscono farla inciampare nella loro tana, rallentarla e consumarla quando non può più difendersi. La loro intelligenza è animale, ma non per questo inefficace. Hanno zanne velenose, corpo massiccio, zampe potenti e tele abbastanza robuste da ostacolare anche un uomo armato. Alcuni esemplari sputano veleno o comandano sciami più piccoli. Contro un Ragno Gigante, il vero nemico è spesso l'ambiente che ha preparato per te.",
        "image": "UnitLorePics/Ragno_Gigante.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 5,
        "name": "Trappola di Ragnatela",
        "description": "La creatura lancia una ragnatela appiccicosa per immobilizzare i nemici.",
        "effect": "Il bersaglio entro 5 esagoni deve effettuare un controllo di agilità pari a 5+lv/2 o avere metà PA per un turno. Può anche metterla a terra, e colpisce chi ci cammina su.",
        "cost": "2 PA, 4 EN.",
        "boost": "Per 3 POW, colpisce fino a 2 bersagli entro la portata."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      }
    ]
  },
