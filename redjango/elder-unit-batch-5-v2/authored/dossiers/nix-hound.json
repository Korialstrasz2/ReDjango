    "lore": [
      {
        "id": 86,
        "unitId": 975,
        "name": "Nix-Hound",
        "description": "I Nix-Hound si trovano nelle terre selvagge di Morrowind, tra ashland, coste e regioni dove insetti, cenere e predatori si contendono ogni spazio. Alcuni vivono allo stato selvatico, altri vengono addomesticati dai Dunmer come cani da guardia o compagni da caccia. La loro presenza è comune, ma non per questo rassicurante. Sono vigili, nervosi e molto legati al gruppo o al padrone quando addestrati. Da selvatici sono predatori rapidi e ostinati; da domestici possono mostrare una fedeltà sorprendente. Restano comunque creature strane agli occhi degli stranieri, più insettoidi che canine nell'aspetto e nei movimenti. Attaccano in modo rapido, usando morso, proboscide e mobilità per indebolire la preda. Non sono grandi come un kagouti, ma possono essere molto più difficili da colpire. In branco diventano pericolosi perché circondano, pungono e arretrano prima della risposta.",
        "image": "UnitLorePics/Nix-Hound.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 19,
        "name": "Nuvola di Spore",
        "description": "Rilascia una nuvola di spore tossiche.",
        "effect": "Tutti i nemici entro 2 esagoni devono effettuare un controllo di resistenza o essere avvelenati e accecati per 2 turni.",
        "cost": "6 PA, 6 EN.",
        "boost": "Per 5 POW, aumenta la portata a 3 esagoni."
      }
    ]
  },
