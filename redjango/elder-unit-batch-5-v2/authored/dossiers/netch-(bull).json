    "lore": [
      {
        "id": 85,
        "unitId": 991,
        "name": "Netch (Bull)",
        "description": "I Bull Netch abitano le stesse regioni delle Betty, ma la loro presenza è molto meno pacifica per chi si avvicina senza prudenza. Si trovano nelle coste, nelle isole e nelle pianure di Morrowind, spesso vicino a gruppi di femmine che proteggono con istinto territoriale. I cacciatori li osservano da lontano prima di decidere se rischiare. Sono protettivi, diffidenti e facili da provocare se percepiscono una minaccia al branco. Non sono crudeli né particolarmente intelligenti, ma hanno la determinazione semplice degli animali che difendono ciò che è loro. Una distanza rispettosa basta spesso a evitare guai; l'arroganza, invece, li attira. Sono più robusti e aggressivi delle Betty, con tentacoli capaci di colpire duramente e un corpo sorprendentemente resistente. La loro pelle è molto apprezzata, ma abbatterli richiede pazienza e buone armi. Un Bull Netch ferito può diventare più pericoloso di quanto la sua lentezza lasci immaginare.",
        "image": "UnitLorePics/Netch_Bull.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      }
    ]
  },
