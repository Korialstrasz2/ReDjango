    "lore": [
      {
        "id": 83,
        "unitId": 1047,
        "name": "Nebbia di zucchero lunare",
        "description": "La Nebbia di Zucchero Lunare, in questa forma mostruosa, non è una normale creatura di Elsweyr ma una perversione quasi esclusiva del piano di Sanguine. Nei suoi domini può apparire come parodia dei piaceri khajiiti, una foschia dolce e lunare che imita il Moon Sugar senza conservarne il valore sacro. Su Tamriel dovrebbe manifestarsi solo in casi rarissimi, quando un rituale di Sanguine sporca sostanze, desideri e vapori alchemici. Sembra priva di mente, eppure reagisce ai viventi come se cercasse respiro, attenzione e abbandono. Non aggredisce con rabbia: avvolge, consola, confonde e invita a restare. Il suo pericolo sta proprio nella dolcezza, perché chi la respira può convincersi che la minaccia sia una benedizione. Non può essere affrontata facilmente con armi comuni, perché il suo corpo è vapore, luce e sostanza allucinogena. Può disorientare, indebolire e imprigionare le vittime in visioni piacevoli o sacre, consumando lentamente lucidità e volontà. Per disperderla servono vento, purificazione o protezioni contro l'Illusione e l'influenza daedrica.",
        "image": "UnitLorePics/Nebbia_di_zucchero_lunare.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 144,
        "name": "Volo",
        "description": "Questa Unità può volare.",
        "effect": "",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 152,
        "name": "Nebbia",
        "description": "",
        "effect": "50% di evitare danno fisico, può teletrasportarsi entro 4 metri instant una volta a turno durante il turno degli altri con 2 pow. Non genera att di opp.",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 153,
        "name": "Assorbimento droga",
        "description": "",
        "effect": "4 PA. Entro 4 metri. Somma tiro res + tiro conc.  CD 7 - comando, CD 11 - frenesia, CD 15 - paralisi, CD 19 - stordito",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 154,
        "name": "Esplosione Nube di Droga",
        "description": "",
        "effect": "Alla morte, esplode facendo Assorbimento Droga su tutti i personaggi confinanti. A terra, rimane 3 zucchero lunare.",
        "cost": "",
        "boost": ""
      }
    ]
