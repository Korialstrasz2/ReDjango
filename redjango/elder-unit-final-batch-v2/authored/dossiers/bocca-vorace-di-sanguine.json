    "lore": [
      {
        "id": 24,
        "unitId": 1050,
        "name": "Bocca Vorace di Sanguine",
        "description": "La Bocca Vorace di Sanguine appartiene quasi unicamente ai reami del Principe dell'Eccesso, dove banchetti, punizioni e appetiti innaturali si confondono senza vergogna. Si trova nei palazzi daedrici, nelle sale dei festini e nelle cucine mostruose del piano di Sanguine, più che su Tamriel. Se appare a Nirn, è quasi sempre per una convocazione maldestra o per una festa daedrica sfuggita al controllo. Non ha una personalità complessa, ma possiede una fame che sembra una forma di devozione. Tutto ciò che la circonda viene interpretato come cibo, gioco o spettacolo disgustoso. La sua presenza trasforma l'abbondanza in minaccia, perché davanti a lei perfino un banchetto diventa una trappola. È una massa carnosa dotata di fauci, lingue e movimenti sgraziati ma sorprendentemente rapidi. Può mordere, afferrare e inghiottire con forza innaturale, lasciando dietro di sé odore di vino, sangue e carne corrotta. Non è elegante, ma rappresenta perfettamente la parte più mostruosa dell'indulgenza senza limite.",
        "image": "UnitLorePics/Bocca_Vorace_di_Sanguine.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 140,
        "name": "Inghiotti pericolo",
        "description": "Inghiotte gli attacchi che vengono da posizioni frontali",
        "effect": "25% di assorbire danno magico, aumentando i PF. 25% di mangiare le armi degli attacchi melee (se c'è l'arma) e il 50% di frecce. Le armi si recuperano a fine combat aprendo il daedra, 10 turni senza oggetti taglienti, altrimenti 2 turni.",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 147,
        "name": "Vomito Acido",
        "description": "",
        "effect": "Vomita in alto, con uno splash di acido che coinvolge tutti i personaggi vicini. 1d4*lv danno puro. 5 PA",
        "cost": "",
        "boost": ""
      }
    ]
  },
