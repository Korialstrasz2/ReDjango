    "lore": [
      {
        "id": 125,
        "unitId": 1051,
        "name": "Tamburo di Sanguine",
        "description": "I Tamburi di Sanguine compaiono quasi esclusivamente nei reami del Principe dell'Eccesso, dove musica, desiderio e perdita di controllo sono parti naturali del paesaggio daedrico. Su Tamriel dovrebbero apparire solo in circostanze eccezionali: un culto che li ha evocati, un portale temporaneo o una festa consacrata a Sanguine e ormai fuori controllo. Non sono strumenti esotici da taverna, ma oggetti viventi del suo dominio. Non hanno una personalità umana, ma sembrano possedere un gusto crudele per la tentazione. Il loro ritmo invita, trascina e corrompe, trasformando desideri innocui in impulsi sempre più difficili da governare. Non costringono con catene: fanno sembrare la catena una scelta piacevole. Il loro suono può confondere, eccitare, spingere alla violenza o dissolvere inibizioni e prudenza. Distruggerli richiede forza di volontà oltre che forza fisica, perché avvicinarsi significa esporsi al loro richiamo. Sono perfetti per Sanguine: non uccidono subito, ma convincono le vittime a partecipare alla propria rovina.",
        "image": "UnitLorePics/Tamburo_di_Sanguine_DkzCUBF.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 149,
        "name": "Danza continua",
        "description": "",
        "effect": "3 PA. In questo turno i personaggi entro 5 metri devono passare CD 8 concentrazione. Se falliscono, passano il turno a danzare e cantare. L'unico controllo che si ha è movimento per metà dei PA, il resto dei PA è ballo.",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 150,
        "name": "Bacchetta Deviatrice",
        "description": "",
        "effect": "2 PA, anche fuori turno. CD 8 Velocità per deviare una freccia o incantesimo in arrivo. Se passa, tira CD 8 Agilità per rispedirlo al lanciatore.",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 151,
        "name": "Colpo Sonico",
        "description": "",
        "effect": "Spende tutto il turno a suonare. Rigenera il 20% dei PF. Infligge 1d10 + lv danno puro entro un metro, 1d6 +lv/2 entro 2 metri, 1d4 + lv/3 entro 3 metri.",
        "cost": "",
        "boost": ""
      }
    ]
  },
