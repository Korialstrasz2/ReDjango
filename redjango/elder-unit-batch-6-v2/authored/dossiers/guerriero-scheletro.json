    "lore": [
      {
        "id": 66,
        "unitId": 1009,
        "name": "Guerriero Scheletro",
        "description": "I Guerrieri Scheletro si trovano in cripte, tombe, rovine e luoghi dove la negromanzia ha trasformato resti umani o elfici in soldati instancabili. Possono essere evocati da necromanti, risvegliati da maledizioni o legati a vecchi campi di battaglia dove la morte non ha mai davvero lasciato il terreno. Sono tra i non morti più comuni, ma questo non li rende innocui. Non hanno volontà propria, né paura, né memoria completa della vita passata. Avanzano con una determinazione vuota, obbedendo a ordini semplici o alla funzione che la magia ha inciso nelle ossa. La loro mancanza di esitazione è ciò che li rende disturbanti: continuano a combattere anche quando qualunque creatura viva sarebbe già fuggita. Usano armi arrugginite, scudi consumati e colpi meccanici ma insistenti. Sono vulnerabili ai colpi contundenti e alla magia adatta, ma non soffrono dolore e non si stancano. Uno Scheletro isolato è gestibile; una fila di scheletri in un corridoio stretto può diventare un problema molto più serio.",
        "image": "UnitLorePics/Guerriero_Scheletro.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 40,
        "name": "Spostamento Fase",
        "description": "La creatura può sfuggire alla realtà.",
        "effect": "Ogni volta che la creatura viene attaccata, c'è il 25% di possibilità che l'attacco manchi completamente.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, la probabilità aumenta al 50% per un turno."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
  },
