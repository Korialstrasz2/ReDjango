    "lore": [
      {
        "id": 129,
        "unitId": 1024,
        "name": "Viverna",
        "description": "Le Viverne sono creature rare e quasi leggendarie, più spesso citate in racconti di cacciatori e bestiari dubbi che incontrate davvero sulle strade di Tamriel. Se esistono in forma stabile, abitano montagne remote, gole ventose e regioni dove la vicinanza a draghi, wyrm o magie antiche ha lasciato tracce strane nella fauna. Molti studiosi preferiscono parlarne come di parenti minori o imitazioni imperfette dei draghi, non come veri Dovah. Sono aggressive, territoriali e molto meno intelligenti dei draghi. Non possiedono la maestà verbale né la volontà dominatrice dei Dovah, ma hanno l'istinto feroce di un predatore alato che conosce bene il proprio vantaggio. Chi le scambia per draghi deboli commette un errore: non sono nobili, ma sono rapide, velenose e difficili da prevedere. Hanno ali, due zampe robuste, artigli e spesso una coda dotata di pungiglione o veleno. Attaccano dall'alto, cercando di isolare e trascinare via le prede più esposte. Per renderle più coerenti con Tamriel, conviene trattarle come creature rarissime, forse nate da leggende vere a metà, piuttosto che come parte comune della fauna.",
        "image": "UnitLorePics/Viverna_anGfEGz.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 51,
        "name": "Tuffo Aereo",
        "description": "Si libra in cielo e si tuffa su un nemico.",
        "effect": "Infligge (4d6 + livello) danni perforanti a un bersaglio entro 6 esagoni; ignora i bonus di difesa dall'armatura.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, stordisce il bersaglio per 1 turno."
      },
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 16,
        "name": "Colpo di Coda",
        "description": "Scuote la coda in un ampio arco per colpire più nemici.",
        "effect": "Attacca con danni contundenti a tutti i PG adiacenti in un arco di ampiezza a scelta; possibilità di sbilanciare abbasstando di 2 i PA.",
        "cost": "6 PA, 4 EN.",
        "boost": "Per 4 POW, +4 atk, +30% danno"
      }
    ]
  },
