    "lore": [
      {
        "id": 32,
        "unitId": 996,
        "name": "Chaurus Cacciatore",
        "description": "I Chaurus Cacciatori si trovano nelle stesse profondità dei Chaurus comuni, ma rappresentano uno stadio più avanzato e inquietante del loro ciclo vitale. Emergono dopo la metamorfosi, lasciandosi dietro il guscio precedente come una promessa di qualcosa di peggiore. Le rovine Falmer più antiche e infestate sono i luoghi in cui è più probabile incontrarli. Sono più mobili, più aggressivi e meno prevedibili dei Chaurus ordinari. Dove il Chaurus comune preme e morde, il Cacciatore si sposta, aggira e sorprende. Il suo comportamento dà l'impressione di una creatura che ha imparato a usare la paura del buio contro chi la prova. Possiedono ali o appendici che permettono brevi voli e movimenti improvvisi, rendendoli difficili da contenere. Mantengono veleno, mandibole e chitina resistente, ma aggiungono una mobilità molto più pericolosa. In un tunnel alto o in una grotta aperta, possono attaccare da angoli che un guerriero non controlla facilmente.",
        "image": "UnitLorePics/Chaurus_Cacciatore.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 51,
        "name": "Tuffo Aereo",
        "description": "Si libra in cielo e si tuffa su un nemico.",
        "effect": "Infligge (4d6 + livello) danni perforanti a un bersaglio entro 6 esagoni; ignora i bonus di difesa dall'armatura.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, stordisce il bersaglio per 1 turno."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      }
    ]
  },
