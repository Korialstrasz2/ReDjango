    "lore": [
      {
        "id": 80,
        "unitId": 1052,
        "name": "Manticora",
        "description": "Le Manticore, o Mantikora secondo alcune fonti più vicine alla tradizione di Tamriel, sono creature rare e innaturali, più legate a esperimenti, alchimia e magie antiche che alla normale fauna del continente. Possono comparire in rovine dimenticate, laboratori abbandonati o regioni selvagge dove una creazione fuggita ha avuto il tempo di riprodursi o diventare leggenda. Non sono bestie comuni: il loro stesso corpo racconta una forzatura. Sono aggressive, territoriali e dotate di una malizia superiore a quella di molti predatori. Non cacciano soltanto per nutrirsi, ma sembrano provare un gusto feroce nell'inseguimento e nella paura della preda. Questo le rende particolarmente inquietanti per i cacciatori di mostri, perché non si comportano mai come semplici animali. Hanno corpo possente, tratti chimerici e spesso una coda velenosa o altre armi naturali derivate dalla loro origine artificiale. Sono robuste, rapide e pericolose sia a distanza ravvicinata sia quando riescono a sfruttare il terreno. Chi le affronta deve aspettarsi una creatura nata da molte minacce fuse insieme, non una sola bestia da catalogo.",
        "image": "UnitLorePics/Manticora.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 1,
        "name": "Colpo d'Ala",
        "description": "La creatura batte le sue potenti ali per respingere i nemici.",
        "effect": "Tutti i nemici entro 2 esagoni devono effettuare un controllo di difesa o essere spinti indietro di 2 esagoni e subire danni contundenti pari a (livello)d4.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta la distanza di spinta a 4 esagoni e il dado del danno a d6."
      },
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 16,
        "name": "Colpo di Coda",
        "description": "Scuote la coda in un ampio arco per colpire più nemici.",
        "effect": "Attacca con danni contundenti a tutti i PG adiacenti in un arco di ampiezza a scelta; possibilità di sbilanciare abbasstando di 2 i PA.",
        "cost": "6 PA, 4 EN.",
        "boost": "Per 4 POW, +4 atk, +30% danno"
      },
      {
        "sourceId": 50,
        "name": "Divorare",
        "description": "Consuma un nemico sconfitto per recuperare forze.",
        "effect": "Può bersagliare solo un nemico caduto; recupera (livello nemico*2) Punti Ferita e guadagna +2 forza per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, recupera anche LV/2 EN e LV/2 POW."
      }
    ]
  },
