    "lore": [
      {
        "id": 97,
        "unitId": 1001,
        "name": "Ragno Daedra",
        "description": "I Ragni Daedra si trovano nei reami di Oblivion, soprattutto dove intrigo, tela e predazione spirituale si intrecciano. Sono spesso associati a Mephala, ma possono comparire anche in altri contesti daedrici legati a segreti, trappole e manipolazione. La loro tana non è mai soltanto un luogo fisico: è una rete. Sono intelligenti, crudeli e pazienti. A differenza di bestie più semplici, osservano le vittime e sembrano godere della confusione che precede la cattura. Hanno un modo quasi elegante di essere mostruosi, come se ogni filo teso fosse parte di un discorso. Hanno corpo aracnide, tratti daedrici e spesso capacità velenose o magiche. Possono intrappolare, rallentare e colpire da posizioni difficili da raggiungere. Combatterli richiede attenzione al terreno, perché spesso lo scontro è già iniziato prima che la vittima veda il ragno.",
        "image": "UnitLorePics/Ragno_Daedra.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 5,
        "name": "Trappola di Ragnatela",
        "description": "La creatura lancia una ragnatela appiccicosa per immobilizzare i nemici.",
        "effect": "Il bersaglio entro 5 esagoni deve effettuare un controllo di agilità pari a 5+lv/2 o avere metà PA per un turno. Può anche metterla a terra, e colpisce chi ci cammina su.",
        "cost": "2 PA, 4 EN.",
        "boost": "Per 3 POW, colpisce fino a 2 bersagli entro la portata."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      }
    ]
  },
