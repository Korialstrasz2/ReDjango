    "lore": [
      {
        "id": 33,
        "unitId": 995,
        "name": "Chaurus Mietitore",
        "description": "Il Chaurus Mietitore vive nei nidi più profondi, vecchi e nutriti delle colonie sotterranee. Non è una creatura comune: quando appare, di solito significa che la zona è stata dominata dai Chaurus per molto tempo. I Falmer più potenti possono tollerarne o guidarne la presenza, ma anche per loro resta una bestia da rispettare. È territoriale, brutale e più sicuro di sé rispetto agli esemplari minori. Non si limita ad attaccare per fame: difende il nido come un sovrano cieco e corazzato. La sua aggressività ha qualcosa di antico, come se anni di sopravvivenza lo avessero reso incapace di considerare qualsiasi creatura una vera minaccia. È enorme, protetto da una chitina spessa e armato di mandibole capaci di infliggere ferite devastanti. Il suo veleno è più pericoloso e la sua forza può travolgere anche combattenti esperti. Contro un Chaurus Mietitore, la miglior tattica è non combattere dove lui si sente a casa.",
        "image": "UnitLorePics/Chaurus_Mietitore.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 2,
        "name": "Sputo Velenoso",
        "description": "La creatura sputa un globo di veleno verso il bersaglio.",
        "effect": "Attacco a distanza fino a 4 esagoni che infligge (2d6 + livello) danni da veleno e infligge lo status veleno per 2 turni.",
        "cost": "4 PA, 5 EN.",
        "boost": "Per 4 POW, aumenta la portata a 6 esagoni e la durata del veleno a 4 turni."
      },
      {
        "sourceId": 11,
        "name": "Inietta veleno gelido",
        "description": "Morde il bersaglio, iniettando un veleno rallentante.",
        "effect": "Da aggiungere dopo aver colpito. Il nemico prende (livello + 2) danno da gelo, e ha -(1 + lv/2) PA il turno successivo",
        "cost": "5 PA, 3 EN.",
        "boost": "Per 3 POW, il veleno infligge il doppio dei danni, per 2 turni."
      },
      {
        "sourceId": 5,
        "name": "Trappola di Ragnatela",
        "description": "La creatura lancia una ragnatela appiccicosa per immobilizzare i nemici.",
        "effect": "Il bersaglio entro 5 esagoni deve effettuare un controllo di agilità pari a 5+lv/2 o avere metà PA per un turno. Può anche metterla a terra, e colpisce chi ci cammina su.",
        "cost": "2 PA, 4 EN.",
        "boost": "Per 3 POW, colpisce fino a 2 bersagli entro la portata."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
  },
