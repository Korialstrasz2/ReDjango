    "lore": [
      {
        "id": 113,
        "unitId": 1034,
        "name": "Slime di Alcol",
        "description": "Gli Slime di Alcol sono quasi sempre creature del piano di Sanguine, dove vino, eccesso, magia e degrado possono diventare materia vivente. Su Tamriel non dovrebbero essere comuni nelle taverne normali: se ne compare uno, è probabile che ci sia stata una contaminazione daedrica, una festa consacrata male o una cantina collegata per qualche ragione al Principe dell'Eccesso. Nel dominio di Sanguine, invece, possono essere una conseguenza naturale dell'abuso trasformato in mostro. Non hanno una vera mente, ma sembrano attratti da calore, musica, rumore e presenza vivente. Si muovono con una goffaggine quasi comica, ma chi ride troppo vicino smette presto di farlo. La loro stranezza li rende meno solenni di altri mostri, ma non necessariamente meno pericolosi. Il loro corpo è una massa gelatinosa impregnata di vapori alcolici e magia instabile. Il contatto può stordire, ubriacare, irritare la pelle o confondere i sensi, mentre il fuoco può distruggerli ma anche trasformarli in una minaccia esplosiva. Sono assurdi, sì, ma nei domini di Sanguine l'assurdo è spesso solo un altro modo di ferire.",
        "image": "UnitLorePics/Slime_di_Alcol.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 138,
        "name": "Esplosione Elementale - Fuoco",
        "description": "La creatura esplode se muore a causa di danni da fuoco.",
        "effect": "(Lv creatura)d6 caselle confinanti, (Lv creatura)d4 quelle successive",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 148,
        "name": "Moltiplicazione di slime di Alcol",
        "description": "",
        "effect": "Se di lv 8+, quando muore da danno non da fuoco, si divide in due slime di lv -2. Non ripetibile.",
        "cost": "",
        "boost": ""
      },
      {
        "sourceId": 155,
        "name": "Assimila",
        "description": "Ingloba in sé un nemico.",
        "effect": "A seguito di un attacco melee può attaccarsi ad un arto del nemico, tipicamente un braccio, e poi l'intero corpo.\nTiro contrapposto di forza per resistere. La creatura inglobata non può essere più grande. Se inglobato, il nemico non può muoversi, soffoca, e riceve lv danno puro a turno.",
        "cost": "3 PA",
        "boost": "3pow, +1 soglia, max +3."
      }
    ]
  },
