    "lore": [
      {
        "id": 107,
        "unitId": 1005,
        "name": "Segugio di Xivilai",
        "description": "I Segugi di Xivilai si trovano nei reami di Oblivion, dove accompagnano Daedra potenti come bestie da caccia, guardiani o simboli di prestigio. Raramente appaiono a Nirn senza un padrone o senza un rituale abbastanza forte da trascinarli fuori dal loro piano. La loro presenza suggerisce quasi sempre che uno Xivilai o un altro potere daedrico non sia lontano. Sono feroci, fedeli e dominati da un istinto predatorio addestrato alla guerra. Non sono semplici cani mostruosi: capiscono gerarchia, possesso e comando con una chiarezza inquietante. Quando scelgono o ricevono un bersaglio, difficilmente si distraggono. Hanno corpo massiccio, mascelle terribili, resistenza soprannaturale e una velocità sorprendente per la loro stazza. Sono fatti per inseguire, atterrare e trattenere prede abbastanza a lungo perché il padrone possa finirle. Ucciderne uno può essere necessario, ma spesso significa attirare una vendetta ancora peggiore.",
        "image": "UnitLorePics/Segugio_di_Xivilai.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 62,
        "name": "Balzo Predatorio",
        "description": "La creatura si lancia sulla preda con precisione letale.",
        "effect": "Salta fino a 3 esagoni su una casella adiacente al bersaglio ed esegue un attacco con +3 all'Attacco e 1 reroll per l'attacco.",
        "cost": "7 PA, 2 EN.",
        "boost": "Per 5 POW, ottieni 2 reroll, e il raggio può essere di 3 o 4 esagoni."
      },
      {
        "sourceId": 54,
        "name": "Passo d'Ombra",
        "description": "Si muove attraverso le ombre per colpire inaspettatamente.",
        "effect": "Si teletrasporta fino a 5 esagoni e effettua un attacco in mischia con bonus di +3 all'attacco.",
        "cost": "5 PA, 4 EN.",
        "boost": "Per 4 POW, l'attacco non può essere parato o bloccato."
      }
    ]
  },
