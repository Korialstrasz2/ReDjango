    "lore": [
      {
        "id": 117,
        "unitId": 1017,
        "name": "Spettro",
        "description": "Gli Spettri si manifestano in luoghi di morte violenta, tradimento, maledizione o dolore rimasto senza risposta. Si trovano in rovine, tumuli, campi di battaglia e case dove l'ombra del passato è troppo pesante per dissolversi. Sono parenti più oscuri dei fantasmi comuni, meno confusi e spesso molto più pericolosi. Sono vendicativi, tormentati e spinti da emozioni rimaste affilate anche dopo la morte. Non sempre ricordano tutto, ma ricordano abbastanza da odiare. A differenza di molti fantasmi, sembrano meno interessati a comunicare e più inclini a trascinare i vivi nel proprio gelo. Il loro corpo è incorporeo, ma il loro tocco può drenare forza, calore e volontà. Le armi comuni spesso servono a poco, mentre argento, incantamenti e magia adatta possono ferirli davvero. Per liberare uno Spettro, talvolta bisogna distruggerlo; altre volte bisogna risolvere il torto che lo ha creato.",
        "image": "UnitLorePics/Spettro.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 33,
        "name": "Forma Eterea",
        "description": "La creatura può entrare in uno stato etereo.",
        "effect": "Ottiene resistenza al danno fisico del 50%, ma subisce il 25% di danno magico in più.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, annulla la penalità al danno magico per un turno."
      },
      {
        "sourceId": 36,
        "name": "Sottrazione Spirituale",
        "description": "Assorbe energia spirituale dai nemici.",
        "effect": "Infligge (2d6 + livello) danni e riduce la saggezza del bersaglio di 2 per 2 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 4 POW, colpisce fino a 2 bersagli entro la portata."
      },
      {
        "sourceId": 40,
        "name": "Spostamento Fase",
        "description": "La creatura può sfuggire alla realtà.",
        "effect": "Ogni volta che la creatura viene attaccata, c'è il 25% di possibilità che l'attacco manchi completamente.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, la probabilità aumenta al 50% per un turno."
      }
    ]
  },
