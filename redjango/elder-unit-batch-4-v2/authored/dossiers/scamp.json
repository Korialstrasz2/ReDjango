    "lore": [
      {
        "id": 103,
        "unitId": 997,
        "name": "Scamp",
        "description": "Gli Scamp si trovano nei piani di Oblivion e nei luoghi di Nirn dove maghi, cultisti o incidenti daedrici li richiamano. Sono tra i Daedra minori più comuni, spesso usati come servitori, famigli, guardiani scadenti o piccoli strumenti di disturbo. La loro presenza è raramente nobile, ma quasi sempre fastidiosa. Sono codardi, dispettosi e più intelligenti di quanto convenga ammettere. Amano infastidire, rubacchiare, ridere nei momenti sbagliati e scappare appena la situazione diventa troppo seria. Se protetti da un padrone più potente, però, diventano molto più audaci e insopportabili. Combattono con artigli, piccoli incantesimi, morsi e movimenti rapidi. Singolarmente non sono grandi minacce per un avventuriero esperto, ma in gruppo o come supporto a un evocatore possono diventare irritanti e pericolosi. Il loro vero talento è distrarre, indebolire e far perdere tempo.",
        "image": "UnitLorePics/Scamp.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 9,
        "name": "Palla di Fuoco",
        "description": "Conjura una palla di fuoco da lanciare ai nemici.",
        "effect": "Infligge (3d6 + livello) danni da fuoco a un bersaglio entro 6 esagoni; danni ad area di (livello)d4 agli esagoni adiacenti.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d8 e il raggio dell'area a 2 esagoni."
      },
      {
        "sourceId": 32,
        "name": "Bruciatura di Mana",
        "description": "Brucia le riserve di mana del bersaglio.",
        "effect": "Infligge (2d6 + livello) danni e riduce il mana del bersaglio di (livello)d4.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 4 POW, raddoppia la riduzione del mana."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
  },
