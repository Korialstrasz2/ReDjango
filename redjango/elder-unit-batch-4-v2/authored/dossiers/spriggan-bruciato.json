    "lore": [
      {
        "id": 119,
        "unitId": 1019,
        "name": "Spriggan Bruciato",
        "description": "Le Spriggan Bruciate si trovano soprattutto nelle terre devastate dal fuoco, dalla cenere e dalla magia vulcanica, come certe zone di Solstheim dopo l'Anno Rosso. Sono ciò che resta di spiriti della natura travolti da una ferita troppo grande per guarire. Non rappresentano più la foresta verde, ma il suo dolore carbonizzato. Sono tormentate, rabbiose e incapaci della calma che talvolta caratterizza le Spriggan comuni. La loro ostilità non nasce solo dalla difesa del territorio, ma da una sofferenza trasformata in fiamma. Sembrano punire qualunque vivente si avvicini, come se ogni intruso fosse complice dell'incendio originario. Il loro corpo è fatto di legno annerito, brace, cenere e magia naturale distorta. Possono bruciare, evocare calore e resistere dove altre creature vegetali morirebbero. Sono tragiche quanto pericolose: abbatterle spesso sembra meno una vittoria che la fine di qualcosa già perduto.",
        "image": "UnitLorePics/Spriggan_Bruciato.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 43,
        "name": "Radici Intrappolanti",
        "description": "Fa emergere radici per immobilizzare i nemici.",
        "effect": "Colpisce fino a 2 nemici entro 4 esagoni; sono immobilizzati per 2 turni.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta il numero di bersagli a 3."
      },
      {
        "sourceId": 18,
        "name": "Sottrai Vita",
        "description": "Draga l'energia vitale dal bersaglio.",
        "effect": "Riduce il bersaglio di (2d6 + livello) Punti Ferita e cura la creatura dello stesso ammontare.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d8."
      },
      {
        "sourceId": 9,
        "name": "Palla di Fuoco",
        "description": "Conjura una palla di fuoco da lanciare ai nemici.",
        "effect": "Infligge (3d6 + livello) danni da fuoco a un bersaglio entro 6 esagoni; danni ad area di (livello)d4 agli esagoni adiacenti.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d8 e il raggio dell'area a 2 esagoni."
      }
    ]
  },
