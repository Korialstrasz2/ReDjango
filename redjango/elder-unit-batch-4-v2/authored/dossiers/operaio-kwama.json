    "lore": [
      {
        "id": 89,
        "unitId": 980,
        "name": "Operaio Kwama",
        "description": "Gli Operai Kwama vivono nelle colonie sotterranee di Morrowind, dove scavano tunnel, trasportano uova e mantengono viva la struttura del nido. Sono la casta più numerosa e indispensabile delle miniere di uova, e i minatori dunmer imparano presto a riconoscerne abitudini e percorsi. Senza di loro, una colonia Kwama crollerebbe in poco tempo. Sono generalmente docili, concentrati sul lavoro e poco interessati agli intrusi finché non vengono minacciati. Non hanno una personalità individuale evidente, ma partecipano a una logica collettiva precisa. Il loro mondo è fatto di odori, tunnel, feromoni e compiti ripetuti con ostinazione. Sono meno pericolosi dei Guerrieri Kwama, ma possono difendersi con morsi, secrezioni e forza sorprendente. Il loro valore sta più nella funzione biologica che nel combattimento. Ucciderne troppi può danneggiare una colonia intera, cosa che i minatori più saggi evitano con cura.",
        "image": "UnitLorePics/Operaio_Kwama.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      }
    ]
