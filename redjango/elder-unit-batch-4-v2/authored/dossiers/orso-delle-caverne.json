    "lore": [
      {
        "id": 91,
        "unitId": 984,
        "name": "Orso delle Caverne",
        "description": "Gli Orsi delle Caverne vivono in grotte, gole, foreste profonde e sistemi sotterranei di Skyrim, High Rock e altre regioni fredde o montuose. Sono più grandi e aggressivi degli orsi comuni, spesso legati a tane antiche e passaggi poco frequentati. Molti viaggiatori li scoprono quando ormai sono troppo vicini. Sono territoriali, solitari e poco disposti a fuggire. Un Orso delle Caverne non attacca sempre per fame: spesso attacca perché qualcuno è entrato nel suo dominio. La sua irritazione è semplice, diretta e devastante. Hanno artigli lunghi, massa enorme e una forza capace di spezzare ossa e scudi. La scarsa luce delle caverne non li svantaggia quanto svantaggia gli uomini, e questo li rende ancora più pericolosi nel loro ambiente. In campo aperto sono temibili; nella loro tana sono padroni.",
        "image": "UnitLorePics/Orso_delle_Caverne.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      },
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
