    "lore": [
      {
        "id": 128,
        "unitId": 1021,
        "name": "Troll del Gelo",
        "description": "I Troll del Gelo abitano le regioni più fredde di Skyrim, Solstheim e delle montagne settentrionali, dove anche le creature comuni faticano a sopravvivere. Sono più grandi, più resistenti e più feroci dei Troll ordinari, adattati a cacciare tra neve, ghiaccio e rocce scivolose. Le storie dei passi montani sono piene di carovane finite male a causa loro. Sono solitari, testardi e molto poco inclini a rinunciare a una preda. Il gelo sembra averli resi ancora più duri e irritabili, come se ogni creatura viva nel loro territorio fosse un'intrusione da schiacciare. Non hanno astuzia raffinata, ma possiedono l'istinto perfetto per colpire quando il freddo ha già indebolito il nemico. Hanno pelliccia chiara, forza enorme e una rigenerazione ancora più problematica di quella dei Troll comuni. Il fuoco resta essenziale per contrastarli, ma nelle condizioni gelide in cui vivono usarlo bene non è sempre semplice. Affrontare un Troll del Gelo su un pendio innevato è una prova tanto contro la creatura quanto contro la montagna.",
        "image": "UnitLorePics/Troll_del_Gelo_8RsGWWf.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 21,
        "name": "Soffio Gelido",
        "description": "Soffia un cono di aria gelida.",
        "effect": "Infligge (4d6 + livello) danni da gelo in un cono largo fino a 3 esagoni.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, rallenta il movimento dei nemici colpiti della metà per 2 turni."
      }
    ]
