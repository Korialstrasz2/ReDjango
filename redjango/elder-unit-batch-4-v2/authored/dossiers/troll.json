    "lore": [
      {
        "id": 127,
        "unitId": 1022,
        "name": "Troll",
        "description": "I Troll si trovano in caverne, foreste, montagne e rovine isolate di molte regioni di Tamriel. Sono creature grandi, scimmiesche e brutali, spesso associate a luoghi umidi, freddi o poco frequentati. Molti viaggiatori li considerano mostri stupidi, ma questa convinzione di solito dura finché il Troll non si rialza dopo una ferita che avrebbe ucciso qualunque altra cosa. Sono territoriali, aggressivi e guidati da fame e irritazione più che da malvagità. Non cercano conversazione né dominio, ma reagiscono con furia a ciò che invade il loro spazio o sembra cibo. La loro semplicità li rende prevedibili, ma non meno pericolosi. La loro caratteristica più temuta è la rigenerazione: ferite profonde si richiudono con velocità innaturale, rendendo inutili molti colpi se non si usa il metodo giusto. Il fuoco è il modo più affidabile per fermare questa guarigione. Senza fiamme o potenza sufficiente, combattere un Troll può diventare una fatica disperata.",
        "image": "UnitLorePics/Troll_It3bOUw.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 20,
        "name": "Pestone Tonante",
        "description": "Colpisce il suolo causando un piccolo terremoto.",
        "effect": "I nemici entro 2 esagoni subiscono (3d6 + livello) danni contundenti e possono essere storditi per 1 turno.",
        "cost": "7 PA, 6 EN.",
        "boost": "Per 5 POW, aumenta la durata dello stordimento a 2 turni."
      }
    ]
