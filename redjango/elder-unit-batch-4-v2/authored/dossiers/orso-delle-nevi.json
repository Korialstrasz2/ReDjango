    "lore": [
      {
        "id": 92,
        "unitId": 983,
        "name": "Orso delle Nevi",
        "description": "Gli Orsi delle Nevi abitano le regioni più fredde di Skyrim, Solstheim e delle montagne settentrionali. Si muovono tra ghiacciai, foreste innevate e passi dove il cibo è raro e ogni creatura deve essere forte per sopravvivere. Per molti cacciatori nordici abbatterne uno è prova di coraggio, ma anche di incoscienza. Sono solitari, aggressivi e molto meno inclini a evitare l'uomo rispetto ad altri animali. Il gelo li ha resi duri, affamati e padroni di territori enormi. Non hanno bisogno di essere malvagi: basta la loro fame a renderli letali. Hanno pelliccia bianca, grande resistenza al freddo e una massa muscolare impressionante. Possono caricare con velocità sorprendente e abbattere un combattente prima che riesca a organizzarsi. Le loro pelli sono preziose, ma spesso costano molto più oro, sangue e vite di quanto valga il trofeo.",
        "image": "UnitLorePics/Orso_delle_Nevi.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      },
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 20,
        "name": "Pestone Tonante",
        "description": "Colpisce il suolo causando un piccolo terremoto.",
        "effect": "I nemici entro 2 esagoni subiscono (3d6 + livello) danni contundenti e possono essere storditi per 1 turno.",
        "cost": "7 PA, 6 EN.",
        "boost": "Per 5 POW, aumenta la durata dello stordimento a 2 turni."
      }
    ]
  },
