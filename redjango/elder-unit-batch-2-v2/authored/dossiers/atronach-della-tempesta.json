    "lore": [
      {
        "id": 17,
        "unitId": 1008,
        "name": "Atronach della Tempesta",
        "description": "Gli Atronach della Tempesta appaiono dove l'aria è carica di energia e la magia dell'evocatore riesce a dare forma al fulmine. Sono creature chiamate spesso da maghi potenti, perché difficili da controllare ma devastanti sul campo. La loro presenza è annunciata da elettricità nell'aria, suoni bassi e una tensione che fa rizzare la pelle. Sono agitati, violenti e quasi incapaci di quiete. Anche quando restano immobili, sembrano sul punto di esplodere in movimento. Non ragionano come mortali, ma reagiscono agli stimoli con la logica improvvisa e brutale di una tempesta. Sono fatti di vento, pietra sospesa, fulmini e pura energia elementale. Colpiscono da lontano con scariche elettriche e possono punire duramente chi si avvicina senza protezioni adeguate. Meno solidi di un Atronach del Gelo, ma molto più imprevedibili, sono tra i servitori elementali più temuti dagli evocatori inesperti.",
        "image": "UnitLorePics/Atronach_della_Tempesta.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 7,
        "name": "Respiro Fulmineo",
        "description": "Scatena un fulmine dalla bocca.",
        "effect": "Infligge (5d6 + livello) danni da shock a un bersaglio entro 6 esagoni.",
        "cost": "7 PA, 6 EN.",
        "boost": "Per 6 POW, aggiunge un effetto di catena fulminea fino a 2 bersagli aggiuntivi entro 2 esagoni."
      },
      {
        "sourceId": 57,
        "name": "Richiamo della Tempesta",
        "description": "Evoca una tempesta che colpisce i nemici con fulmini.",
        "effect": "Infligge (3d6 + livello) danni da shock fino a 3 nemici entro 6 esagoni.",
        "cost": "6 PA, 6 EN.",
        "boost": "Per 5 POW, il danno ignora le resistenze."
      },
      {
        "sourceId": 48,
        "name": "Scudo di Mana",
        "description": "Converte il mana in una barriera protettiva.",
        "effect": "Utilizza 10 Mana per assorbire 20 danni per 2 turni.",
        "cost": "4 PA, 10 Mana.",
        "boost": "Per 5 POW, aumenta l'assorbimento a 30 danni."
      }
    ]
  },
