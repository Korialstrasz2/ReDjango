    "lore": [
      {
        "id": 48,
        "unitId": 1025,
        "name": "Drago d’Ossa",
        "description": "I Draghi d'Ossa si trovano nei luoghi di sepoltura draconica, nei reami della morte e nelle mani di negromanti abbastanza folli da tentare di piegare resti simili. Non sono veri Dovah nel senso pieno del termine, perché ciò che li anima non è la vita antica del drago, ma una forza imposta sulle sue ossa. Proprio per questo risultano sacrileghi anche agli occhi di molti studiosi. Non possiedono la piena coscienza di un drago vivente, ma qualcosa della sua presenza rimane. Si muovono con la maestà rotta di un re caduto, e ogni gesto sembra una parodia della potenza originaria. Non parlano come i Dovah, ma il loro silenzio è quasi peggiore. Sono scheletri colossali animati da magia necromantica, capaci di volare o trascinarsi con forza devastante a seconda del rituale che li sostiene. Le ossa draconiche sono dure, antiche e cariche di potere residuo. Distruggerli significa non solo spezzare il corpo, ma interrompere la magia che costringe quei resti a combattere.",
        "image": "UnitLorePics/Drago_dOssa.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 51,
        "name": "Tuffo Aereo",
        "description": "Si libra in cielo e si tuffa su un nemico.",
        "effect": "Infligge (4d6 + livello) danni perforanti a un bersaglio entro 6 esagoni; ignora i bonus di difesa dall'armatura.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, stordisce il bersaglio per 1 turno."
      },
      {
        "sourceId": 52,
        "name": "Soffio Pestilenziale",
        "description": "Espira un gas tossico che indebolisce i nemici.",
        "effect": "I nemici entro 3 esagoni perdono 2 forza e resistenza per 2 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 4 POW, riduce anche l'agilità dei nemici di 2."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      }
    ]
  },
