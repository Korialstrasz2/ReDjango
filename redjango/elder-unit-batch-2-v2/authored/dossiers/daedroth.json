    "lore": [
      {
        "id": 45,
        "unitId": 999,
        "name": "Daedroth",
        "description": "I Daedroth si trovano nei piani di Oblivion e nei luoghi di Nirn dove una presenza daedrica ha preso abbastanza forza da trascinare con sé creature maggiori. Sono spesso associati a Molag Bal, ma possono comparire al servizio di diversi poteri. La loro apparizione in un santuario o in una rovina è quasi sempre segno che la situazione è già degenerata. Sono brutali, aggressivi e dotati di una cattiveria più istintiva che raffinata. Non hanno la disciplina dei Dremora né l'astuzia di certe entità superiori, ma possiedono una sicurezza feroce nella propria forza. Guardano i mortali come prede rumorose e fragili. Il loro corpo rettiliano, la testa simile a quella di un coccodrillo e la massa muscolare li rendono avversari terrificanti nel corpo a corpo. Possono mordere, travolgere e in alcuni casi sputare o evocare fiamme. Sono difficili da fermare, e ancora più difficili da affrontare in spazi stretti.",
        "image": "UnitLorePics/Daedroth.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 52,
        "name": "Soffio Pestilenziale",
        "description": "Espira un gas tossico che indebolisce i nemici.",
        "effect": "I nemici entro 3 esagoni perdono 2 forza e resistenza per 2 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 4 POW, riduce anche l'agilità dei nemici di 2."
      },
      {
        "sourceId": 9,
        "name": "Palla di Fuoco",
        "description": "Conjura una palla di fuoco da lanciare ai nemici.",
        "effect": "Infligge (3d6 + livello) danni da fuoco a un bersaglio entro 6 esagoni; danni ad area di (livello)d4 agli esagoni adiacenti.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d8 e il raggio dell'area a 2 esagoni."
      },
      {
        "sourceId": 16,
        "name": "Colpo di Coda",
        "description": "Scuote la coda in un ampio arco per colpire più nemici.",
        "effect": "Attacca con danni contundenti a tutti i PG adiacenti in un arco di ampiezza a scelta; possibilità di sbilanciare abbasstando di 2 i PA.",
        "cost": "6 PA, 4 EN.",
        "boost": "Per 4 POW, +4 atk, +30% danno"
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
  },
