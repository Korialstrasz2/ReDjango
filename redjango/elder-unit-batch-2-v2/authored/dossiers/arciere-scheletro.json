    "lore": [
      {
        "id": 12,
        "unitId": 1010,
        "name": "Arciere Scheletro",
        "description": "Gli Arcieri Scheletro si trovano nelle cripte, nei tumuli, nelle rovine ayleid e nei vecchi campi di battaglia dove la negromanzia o una maledizione hanno impedito ai morti di restare tali. Non appartengono a una cultura unica: possono essere resti di soldati imperiali, guardie dimenticate, antichi cultisti o semplici cadaveri armati e rimessi in piedi da un incantatore senza scrupoli. Non hanno una vera personalità, ma conservano una parodia inquietante del compito che svolgevano in vita. Restano immobili per anni, con l'arco tra le dita ossute, finché un intruso non supera il limite che sono stati posti a difendere. Non provano paura, fame o stanchezza, e proprio questa assenza li rende più sgradevoli di molti nemici vivi. Sono fragili se colpiti con forza, ma pericolosi quando combattono da lontano o in gruppo. Le loro frecce non sono sempre precise, ma vengono scagliate senza esitazione e senza bisogno di riposo. In una cripta stretta o in una sala piena di colonne, anche un semplice Arciere Scheletro può diventare una minaccia seria.",
        "image": "UnitLorePics/Arciere_Scheletro.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 40,
        "name": "Spostamento Fase",
        "description": "La creatura può sfuggire alla realtà.",
        "effect": "Ogni volta che la creatura viene attaccata, c'è il 25% di possibilità che l'attacco manchi completamente.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, la probabilità aumenta al 50% per un turno."
