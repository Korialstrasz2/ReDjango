        "sourceId": 29,
        "name": "Teletrasporto",
        "description": "Si sposta istantaneamente in un'altra posizione.",
        "effect": "Si teletrasporta fino a 8 esagoni di distanza.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, può teletrasportarsi fino a 12 esagoni."
      }
    ]
