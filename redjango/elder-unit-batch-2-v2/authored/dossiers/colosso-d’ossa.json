    "lore": [
      {
        "id": 37,
        "unitId": 1012,
        "name": "Colosso d’Ossa",
        "description": "I Colossi d'Ossa si trovano nelle cripte più oscure, nei campi di battaglia maledetti e nei laboratori di negromanti abbastanza potenti da trattare i morti come materiale da guerra. Non sono semplici non morti, ma costruzioni rituali nate dall'unione di molte ossa e molte morti. Ogni loro passo sembra portare con sé il rumore di un'intera fossa comune. Non possiedono una personalità vera, ma sono animati da una volontà imposta, pesante e crudele. La magia che li tiene insieme non vuole vivere: vuole obbedire, travolgere e spezzare. La loro presenza mette paura perché cancella l'idea stessa del riposo dei morti. Sono enormi, resistenti e capaci di spazzare via gruppi interi con colpi devastanti. Le armi leggere servono a poco contro una massa simile, mentre magia sacra, fuoco potente o colpi contundenti ben assestati possono incrinare i legamenti negromantici. Affrontarne uno senza preparazione è più arroganza che coraggio.",
        "image": "UnitLorePics/Colosso_dOssa.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 20,
        "name": "Pestone Tonante",
        "description": "Colpisce il suolo causando un piccolo terremoto.",
        "effect": "I nemici entro 2 esagoni subiscono (3d6 + livello) danni contundenti e possono essere storditi per 1 turno.",
        "cost": "7 PA, 6 EN.",
        "boost": "Per 5 POW, aumenta la durata dello stordimento a 2 turni."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      },
      {
        "sourceId": 63,
        "name": "Scudo d'Ossa",
        "description": "Evoca frammenti di ossa per bloccare i colpi in arrivo.",
        "effect": "Riduce del 50% i danni del prossimo attacco fisico in arrivo. Dura 2 turni o fino all'attivazione.",
        "cost": "3 PA, 5 EN.",
        "boost": "Per 5 POW, si applica anche ai danni magici."
      }
    ]
  },
