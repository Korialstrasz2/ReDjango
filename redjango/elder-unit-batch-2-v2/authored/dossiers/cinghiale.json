    "lore": [
      {
        "id": 34,
        "unitId": 988,
        "name": "Cinghiale",
        "description": "I Cinghiali si trovano nelle foreste, nelle campagne e nelle zone selvagge di molte province di Tamriel. Sono animali comuni, spesso cacciati per la carne e la pelle, ma anche temuti dai contadini quando devastano campi o attaccano cani e viandanti. A prima vista sembrano solo selvaggina, ma chi li conosce sa che un cinghiale ferito è un pericolo serio. Sono nervosi, testardi e molto più aggressivi di quanto sembri. Non cercano sempre lo scontro, ma reagiscono male alla sorpresa, alla fame o alla minaccia verso i piccoli. Un cacciatore esperto li tratta con rispetto, perché la loro furia improvvisa può rovinare anche una battuta ben preparata. Hanno zanne robuste, corpo compatto e una carica capace di sbilanciare un uomo adulto. Non possiedono magia né astuzia particolare, ma compensano con resistenza e violenza diretta. Sono creature semplici, e proprio per questo pericolose quando l'istinto prende il sopravvento.",
        "image": "UnitLorePics/Cinghiale.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
