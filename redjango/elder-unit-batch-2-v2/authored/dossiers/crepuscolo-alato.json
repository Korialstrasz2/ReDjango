    "lore": [
      {
        "id": 41,
        "unitId": 1003,
        "name": "Crepuscolo Alato",
        "description": "I Crepuscoli Alati sono Daedra rari, associati soprattutto ai reami di Oblivion e alle sfere più enigmatiche dei Principi, in particolare Azura nelle tradizioni di Morrowind. Appaiono come messaggeri, guardiani o creature evocate da maghi che cercano servitori più intelligenti di una semplice bestia daedrica. La loro presenza ha sempre qualcosa di ambiguo, tra bellezza e minaccia. Sono orgogliosi, intelligenti e molto più consapevoli di molti Daedra minori. Non si comportano come animali: osservano, giudicano e spesso sembrano capire perfettamente la paura che suscitano. Possono servire un potere superiore, ma raramente danno l'impressione di essere creature umili. Hanno forma femminile alata, artigli affilati e una natura magica che li rende avversari pericolosi sia in aria sia a terra. Possono colpire rapidamente, usare la mobilità per confondere il nemico e accompagnare gli attacchi fisici con poteri arcani. Chi li scambia per apparizioni eleganti scopre presto che la grazia non esclude la ferocia.",
        "image": "UnitLorePics/Crepuscolo_Alato.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 51,
        "name": "Tuffo Aereo",
        "description": "Si libra in cielo e si tuffa su un nemico.",
        "effect": "Infligge (4d6 + livello) danni perforanti a un bersaglio entro 6 esagoni; ignora i bonus di difesa dall'armatura.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, stordisce il bersaglio per 1 turno."
      },
      {
        "sourceId": 22,
        "name": "Sferzata Mentale",
        "description": "Attacca la mente del bersaglio con energia psichica.",
        "effect": "Infligge (3d6 + livello) danni psichici; il bersaglio deve effettuare un controllo di intelligenza o essere confuso per 1 turno.",
        "cost": "5 PA, 6 EN.",
        "boost": "Per 5 POW, la confusione dura 2 turni."
      },
      {
        "sourceId": 14,
        "name": "Fondersi nell'Ombra",
        "description": "La creatura si fonde naturalmente con le ombre.",
        "effect": "Ottiene invisibilità in condizioni di scarsa illuminazione; attaccare rompe l'invisibilità.",
        "cost": "N/A (Passiva).",
        "boost": "N/A (Passiva)."
      }
    ]
