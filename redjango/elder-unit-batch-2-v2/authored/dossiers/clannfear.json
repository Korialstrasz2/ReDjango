    "lore": [
      {
        "id": 35,
        "unitId": 1000,
        "name": "Clannfear",
        "description": "I Clannfear si trovano nei piani di Oblivion e nei luoghi di Nirn dove vengono evocati da congiuratori, cultisti o poteri daedrici. Sono Daedra bestiali, spesso impiegati come guardiani, predatori o strumenti d'assalto. La loro comparsa in un santuario abbandonato o in una rovina corrotta è quasi sempre segno che qualcuno ha chiamato forze sbagliate. Sono aggressivi, territoriali e poco inclini a qualsiasi forma di esitazione. Non possiedono la disciplina dei Dremora, ma hanno l'istinto feroce di una bestia nata per l'attacco. Obbediscono quando sono costretti o addestrati magicamente, ma restano creature pericolose anche per chi le ha evocate. Il loro corpo ricorda un rettile bipede, con testa corazzata, artigli e una velocità sorprendente. Attaccano con balzi, morsi e colpi improvvisi, cercando di travolgere il bersaglio prima che possa reagire. Sono particolarmente pericolosi contro avversari isolati o presi alla sprovvista.",
        "image": "UnitLorePics/Clannfear.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 4,
        "name": "Carica",
        "description": "La creatura si lancia verso il nemico con grande forza.",
        "effect": "Si muove fino a 5 esagoni in linea retta; se raggiunge un nemico, infligge (3d8 + livello) danni contundenti e lo sbilancia.",
        "cost": "6 PA, 3 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d10 e il movimento a 7 esagoni."
      },
      {
        "sourceId": 16,
        "name": "Colpo di Coda",
        "description": "Scuote la coda in un ampio arco per colpire più nemici.",
        "effect": "Attacca con danni contundenti a tutti i PG adiacenti in un arco di ampiezza a scelta; possibilità di sbilanciare abbasstando di 2 i PA.",
        "cost": "6 PA, 4 EN.",
        "boost": "Per 4 POW, +4 atk, +30% danno"
      },
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      }
    ]
  },
