    "lore": [
      {
        "id": 49,
        "unitId": 1014,
        "name": "Draugr Guerriero",
        "description": "I Draugr Guerrieri infestano i tumuli nordici, le sale funerarie e le antiche rovine dove il Culto del Drago lasciò sepolti servitori, soldati e guardiani. Sono particolarmente comuni nelle cripte di Skyrim, dove il silenzio dei secoli viene rotto dal raschiare dei loro passi. Ogni barrow che li ospita è un frammento armato di una storia che i Nord moderni preferirebbero non rivivere. Non sono semplici scheletri animati: conservano abitudini, disciplina e un'eco distorta della volontà che avevano in vita. Molti continuano a custodire sale, sacerdoti o tesori come se il tempo non fosse mai passato. Non provano paura e non ragionano come uomini vivi, ma la loro ostinazione ha qualcosa di terribilmente umano. Combattono con armi nordiche, scudi, armature antiche e talvolta frammenti della Voce. Sono lenti rispetto a un guerriero vivo, ma resistenti, implacabili e capaci di coordinarsi con altri non morti del tumulo. In spazi stretti, tra trappole e sarcofagi, diventano molto più pericolosi di quanto sembri.",
        "image": "UnitLorePics/Draugr_Guerriero.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 28,
        "name": "Furia",
        "description": "Entra in uno stato di rabbia, aumentando la potenza fisica.",
        "effect": "Aumenta la forza di 4 e l'attacco di 3 per 3 turni; riduce la difesa di 2.",
        "cost": "4 PA, 4 EN.",
        "boost": "Per 4 POW, aumenta la durata a 5 turni."
      },
      {
        "sourceId": 17,
        "name": "Pelle di Pietra",
        "description": "La pelle si indurisce come la pietra, riducendo i danni subiti.",
        "effect": "Riduce tutti i danni in arrivo del 50% per 3 turni.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, riflette anche il 10% dei danni agli attaccanti."
      },
      {
        "sourceId": 49,
        "name": "Aura della Paura",
        "description": "La presenza incute timore nei nemici vicini.",
        "effect": "I nemici entro 2 esagoni hanno il loro attacco e difesa ridotti di 2.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può sopprimere l'effetto per 2 turni per causare un effetto di paura."
      }
    ]
  },
