    "lore": [
      {
        "id": 47,
        "unitId": 1026,
        "name": "Drago Spettrale",
        "description": "I Draghi Spettrali appaiono nei luoghi dove morte, anima e memoria draconica si sono intrecciate in modo innaturale. Possono manifestarsi presso antiche tombe, rovine legate ai Sacerdoti Drago o reami come il Soul Cairn, dove le anime perdute diventano sostanza del paesaggio. Sono rari, e la loro presenza indica quasi sempre un trauma magico profondo. Non hanno la stessa vitalità arrogante dei draghi viventi, ma conservano una volontà fredda e remota. Sembrano fatti di ricordo, rabbia e potere incompleto. Alcuni agiscono come guardiani, altri come resti inquieti di una grandezza che non riesce a dissolversi. Il loro corpo è etereo, difficile da colpire con armi comuni e spesso accompagnato da gelo, luce spettrale o energia necromantica. Possono ancora usare parte della forza draconica, anche se in forma distorta. Affrontarli richiede armi incantate, magia adatta e il coraggio di combattere qualcosa che non è del tutto presente.",
        "image": "UnitLorePics/Drago_Spettrale.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 33,
        "name": "Forma Eterea",
        "description": "La creatura può entrare in uno stato etereo.",
        "effect": "Ottiene resistenza al danno fisico del 50%, ma subisce il 25% di danno magico in più.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, annulla la penalità al danno magico per un turno."
      },
      {
        "sourceId": 7,
        "name": "Respiro Fulmineo",
        "description": "Scatena un fulmine dalla bocca.",
        "effect": "Infligge (5d6 + livello) danni da shock a un bersaglio entro 6 esagoni.",
        "cost": "7 PA, 6 EN.",
        "boost": "Per 6 POW, aggiunge un effetto di catena fulminea fino a 2 bersagli aggiuntivi entro 2 esagoni."
      },
      {
        "sourceId": 51,
        "name": "Tuffo Aereo",
        "description": "Si libra in cielo e si tuffa su un nemico.",
        "effect": "Infligge (4d6 + livello) danni perforanti a un bersaglio entro 6 esagoni; ignora i bonus di difesa dall'armatura.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, stordisce il bersaglio per 1 turno."
      }
    ]
  },
