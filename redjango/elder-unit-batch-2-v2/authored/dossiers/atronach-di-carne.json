    "lore": [
      {
        "id": 18,
        "unitId": 1002,
        "name": "Atronach di Carne",
        "description": "Gli Atronach di Carne non nascono spontaneamente: vengono creati. Si trovano nei laboratori di negromanti, nelle sale di maghi corrotti e nei luoghi dove la carne è stata trattata come materiale da costruzione invece che come vita. La loro esistenza stessa è una profanazione, e spesso il luogo che li ospita porta ancora l'odore del rituale che li ha generati. Non possiedono una vera mente, ma qualcosa in loro sembra soffrire. Si muovono con pesantezza rabbiosa, come se ogni parte del corpo volesse andare in una direzione diversa. Non parlano, ma i loro versi bastano a ricordare che sono composti da ciò che un tempo apparteneva a esseri vivi. Sono enormi, resistenti e disgustosamente difficili da abbattere. La loro forza viene dalla massa, dalla carne cucita e dalla magia che impedisce al corpo di cedere. Non sono eleganti né rapidi, ma quando colpiscono sembrano scaricare tutto l'orrore della loro creazione in un solo impatto.",
        "image": "UnitLorePics/Atronach_di_Carne.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 6,
        "name": "Pelle Rigenerativa",
        "description": "La pelle dura della creatura guarisce rapidamente le ferite minori.",
        "effect": "Recupera (livello)d4 Punti Ferita alla fine di ogni turno.",
        "cost": "N/A (Passiva).",
        "boost": "Per 5 POW, può raddoppiare la guarigione per un turno."
      },
      {
        "sourceId": 13,
        "name": "Scoppio di Rigenerazione",
        "description": "Canalizza energia per guarire rapidamente le ferite.",
        "effect": "Recupera immediatamente (3d8 + livello) Punti Ferita.",
        "cost": "5 PA, 5 EN.",
        "boost": "Per 5 POW, rimuove anche un effetto negativo."
      },
      {
        "sourceId": 16,
        "name": "Colpo di Coda",
        "description": "Scuote la coda in un ampio arco per colpire più nemici.",
        "effect": "Attacca con danni contundenti a tutti i PG adiacenti in un arco di ampiezza a scelta; possibilità di sbilanciare abbasstando di 2 i PA.",
        "cost": "6 PA, 4 EN.",
        "boost": "Per 4 POW, +4 atk, +30% danno"
      }
    ]
