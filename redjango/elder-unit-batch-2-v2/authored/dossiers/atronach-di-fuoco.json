    "lore": [
      {
        "id": 19,
        "unitId": 1006,
        "name": "Atronach di Fuoco",
        "description": "Gli Atronach di Fuoco vengono evocati dai piani ardenti dell'Oblivion o richiamati dove la magia distruttiva ha acceso un varco abbastanza stabile. Si trovano spesso al servizio di maghi da battaglia, cultisti daedrici o stregoni che preferiscono bruciare un problema invece di risolverlo. In ambienti vulcanici o rovine incendiate, sembrano fondersi con il paesaggio. Sono aggressivi, rapidi e pieni di una furia che non ha bisogno di parole. A differenza di altri costrutti elementali, danno l'impressione di danzare mentre distruggono. Ogni movimento è scintilla, ogni passo è minaccia, e tutto ciò che li circonda sembra diventare più fragile. Il loro corpo è fatto di fiamma, cenere e magia legata insieme. Attaccano con getti di fuoco, esplosioni ravvicinate e calore costante, risultando devastanti contro nemici impreparati. Sono però creature instabili: quando vengono distrutti, la loro fine può essere pericolosa quasi quanto la loro presenza.",
        "image": "UnitLorePics/Atronach_di_Fuoco.png"
      }
    ],
    "legacyActions": [
      {
        "sourceId": 9,
        "name": "Palla di Fuoco",
        "description": "Conjura una palla di fuoco da lanciare ai nemici.",
        "effect": "Infligge (3d6 + livello) danni da fuoco a un bersaglio entro 6 esagoni; danni ad area di (livello)d4 agli esagoni adiacenti.",
        "cost": "6 PA, 5 EN.",
        "boost": "Per 5 POW, aumenta i dadi del danno a d8 e il raggio dell'area a 2 esagoni."
      },
      {
        "sourceId": 15,
        "name": "Aura di Fiamme",
        "description": "Circondata da un'aura di fiamme che danneggia gli attaccanti.",
        "effect": "Gli attaccanti in mischia subiscono danni da fuoco pari a (livello)d4 quando colpiscono la creatura.",
        "cost": "N/A (Passiva).",
        "boost": "Per 3 POW, aumenta i dadi del danno a d6 per un turno."
      },
      {
        "sourceId": 48,
        "name": "Scudo di Mana",
        "description": "Converte il mana in una barriera protettiva.",
        "effect": "Utilizza 10 Mana per assorbire 20 danni per 2 turni.",
        "cost": "4 PA, 10 Mana.",
        "boost": "Per 5 POW, aumenta l'assorbimento a 30 danni."
      }
    ]
